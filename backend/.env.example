# Copy to .env and change what you need. Every value here is optional.

# Port the server listens on
PORT=3000

# Random delay (ms) added to every /api call, so loading states and race
# conditions are real. Set 0 for instant responses while writing tests.
LATENCY_MS=250

# The kitchen moves orders along by itself: placed -> accepted -> preparing -> ready
AUTO_COOK=true
KITCHEN_TICK_MS=10000

# Orders per minute per IP before the limiter kicks in
ORDER_RATE_MAX=40

# Turn off the per-request log line
QUIET=false
